{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jorges_launcher_mc",
  "version": "1.0.0",
  "identifier": "com.primatasdev.jorges_launcher_mc",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jorges Launcher MC",
        "width": 600,
        "height": 400,
        "resizable": false,
        "fullscreen": false,
        "maximizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
